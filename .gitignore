# ---- Python ----
__pycache__/
*.py[cod]
*.so
*.egg-info/
build/
dist/
.venv/
venv/
env/

# ---- 测试与检查缓存 ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# ---- 密钥与环境 ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# ---- 编辑器与系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- Office 临时锁文件 ----
~$*

# ---- 生成物：流水线产物不进版本库 ----
output/

# ---- 开发工具工作区（AI 助手的工作记忆，属草稿纸，不进版本库）----
# 注意：规则只对未跟踪文件生效，已入库的需先 git rm --cached
.workbuddy/

# ---- 本地数据（样例数据可提交，真实数据不可） ----
data/*.csv
data/*.xlsx
data/*.db
data/*.db-journal
!data/sample_*.md
data/.rag_cache/
data/knowledge/
# 密钥类文件绝不进版本库（注意：gitignore 不支持行尾注释，注释必须独占一行）
data/.jwt_secret
data/.admin_credentials
data/.agent_secret
data/tmp_*.db
